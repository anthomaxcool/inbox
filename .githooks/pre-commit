#!/bin/sh
# gitleaks on staged changes (plan §8.12). Install: https://github.com/gitleaks/gitleaks#installing
if ! command -v gitleaks >/dev/null 2>&1; then
	echo "pre-commit: gitleaks is not installed. Install it; commits are blocked without it." >&2
	exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
